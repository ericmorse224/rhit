`timescale 1 ps/ 1 ps
module Lab6_test_vlg_sample_tst(
	CLK,
	END_LEFT,
	END_MID,
	END_RIGHT,
	LEFT,
	MID,
	nOVER,
	RESET,
	RIGHT,
	START,
	TIME,
	sampler_tx
);
input  CLK;
input  END_LEFT;
input  END_MID;
input  END_RIGHT;
input  LEFT;
input  MID;
input  nOVER;
input  RESET;
input  RIGHT;
input  START;
input  TIME;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or END_LEFT or END_MID or END_RIGHT or LEFT or MID or nOVER or RESET or RIGHT or START or TIME)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

