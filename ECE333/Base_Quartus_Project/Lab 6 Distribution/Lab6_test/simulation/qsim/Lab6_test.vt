		$display ("ERROR! Vector Mismatch for output port STATE[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[1] = STATE_expected_prev[1];
	end
	if (
		( STATE_expected_prev[2] !== 1'bx ) && ( STATE_prev[2] !== STATE_expected_prev[2] )
		&& ((STATE_expected_prev[2] !== last_STATE_exp[2]) ||
			on_first_change[13])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port STATE[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[2] = STATE_expected_prev[2];
	end
	if (
		( STATE_expected_prev[3] !== 1'bx ) && ( STATE_prev[3] !== STATE_expected_prev[3] )
		&& ((STATE_expected_prev[3] !== last_STATE_exp[3]) ||
			on_first_change[13])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port STATE[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[3] = STATE_expected_prev[3];
	end
	if (
		( STATE_expected_prev[4] !== 1'bx ) && ( STATE_prev[4] !== STATE_expected_prev[4] )
		&& ((STATE_expected_prev[4] !== last_STATE_exp[4]) ||
			on_first_change[13])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port STATE[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[4] = STATE_expected_prev[4];
	end
	if (
		( STATE_expected_prev[5] !== 1'bx ) && ( STATE_prev[5] !== STATE_expected_prev[5] )
		&& ((STATE_expected_prev[5] !== last_STATE_exp[5]) ||
			on_first_change[13])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port STATE[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[5] = STATE_expected_prev[5];
	end
	if (
		( STATE_expected_prev[6] !== 1'bx ) && ( STATE_prev[6] !== STATE_expected_prev[6] )
		&& ((STATE_expected_prev[6] !== last_STATE_exp[6]) ||
			on_first_change[13])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port STATE[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", STATE_expected_prev);
		$display ("     Real value = %b", STATE_prev);
		nummismatches = nummismatches + 1;
		on_first_change[13] = 1'b0;
		last_STATE_exp[6] = STATE_expected_prev[6];
	end
	if (
		( state_error_expected_prev !== 1'bx ) && ( state_error_prev !== state_error_expected_prev )
		&& ((state_error_expected_prev !== last_state_error_exp) ||
			on_first_change[14])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port state_error :: @time = %t",  $realtime);
		$display ("     Expected value = %b", state_error_expected_prev);
		$display ("     Real value = %b", state_error_prev);
		nummismatches = nummismatches + 1;
		on_first_change[14] = 1'b0;
		last_state_error_exp = state_error_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Lab6_test_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg END_LEFT;
reg END_MID;
reg END_RIGHT;
reg LEFT;
reg MID;
reg nOVER;
reg RESET;
reg RIGHT;
reg START;
reg TIME;
// wires                                               
wire G_INC_MISS;
wire G_INC_SCORE;
wire G_LOAD_NOTE;
wire G_nCLRPT;
wire G_SHIFT;
wire [6:0] G_STATE;
wire INC_MISS;
wire INC_SCORE;
wire LOAD_NOTE;
wire nCLRPT;
wire output_error;
wire SHIFT;
wire [6:0] STATE;
wire state_error;

wire sampler;                             

// assign statements (if any)                          
Lab6_test i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.END_LEFT(END_LEFT),
	.END_MID(END_MID),
	.END_RIGHT(END_RIGHT),
	.G_INC_MISS(G_INC_MISS),
	.G_INC_SCORE(G_INC_SCORE),
	.G_LOAD_NOTE(G_LOAD_NOTE),
	.G_nCLRPT(G_nCLRPT),
	.G_SHIFT(G_SHIFT),
	.G_STATE(G_STATE),
	.INC_MISS(INC_MISS),
	.INC_SCORE(INC_SCORE),
	.LEFT(LEFT),
	.LOAD_NOTE(LOAD_NOTE),
	.MID(MID),
	.nCLRPT(nCLRPT),
	.nOVER(nOVER),
	.output_error(output_error),
	.RESET(RESET),
	.RIGHT(RIGHT),
	.SHIFT(SHIFT),
	.START(START),
	.STATE(STATE),
	.state_error(state_error),
	.\TIME (TIME)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #10000 1'b1;
	#10000;
end 

// RESET
initial
begin
	RESET = 1'b1;
	RESET = #20000 1'b0;
end 

// nOVER
initial
begin
	nOVER = 1'b1;
	nOVER = #520000 1'b0;
	nOVER = #20000 1'b1;
end 

// START
initial
begin
	START = 1'b0;
	START = #20000 1'b1;
	START = #20000 1'b0;
	START = #540000 1'b1;
	START = #20000 1'b0;
	START = #40000 1'b1;
	START = #20000 1'b0;
end 

// TIME
initial
begin
	TIME = 1'b0;
	TIME = #60000 1'b1;
	TIME = #20000 1'b0;
	TIME = #20000 1'b1;
	TIME = #10000 1'b0;
	TIME = #70000 1'b1;
	TIME = #20000 1'b0;
	TIME = #20000 1'b1;
	TIME = #10000 1'b0;
	TIME = #70000 1'b1;
	TIME = #20000 1'b0;
	TIME = #20000 1'b1;
	TIME = #10000 1'b0;
	TIME = #50000 1'b1;
	TIME = #20000 1'b0;
	TIME = #20000 1'b1;
	TIME = #10000 1'b0;
	TIME = #30000 1'b1;
	TIME = #20000 1'b0;
end 

// LEFT
initial
begin
	LEFT = 1'b0;
	LEFT = #140000 1'b1;
	LEFT = #20000 1'b0;
end 

// MID
initial
begin
	MID = 1'b0;
	MID = #260000 1'b1;
	MID = #20000 1'b0;
end 

// RIGHT
initial
begin
	RIGHT = 1'b0;
	RIGHT = #380000 1'b1;
	RIGHT = #20000 1'b0;
end 

// END_LEFT
initial
begin
	END_LEFT = 1'b1;
	END_LEFT = #110000 1'b0;
	END_LEFT = #50000 1'b1;
	END_LEFT = #290000 1'b0;
	END_LEFT = #50000 1'b1;
end 

// END_MID
initial
begin
	END_MID = 1'b1;
	END_MID = #230000 1'b0;
	END_MID = #50000 1'b1;
end 

// END_RIGHT
initial
begin
	END_RIGHT = 1'b1;
	END_RIGHT = #350000 1'b0;
	END_RIGHT = #50000 1'b1;
end 

Lab6_test_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.END_LEFT(END_LEFT),
	.END_MID(END_MID),
	.END_RIGHT(END_RIGHT),
	.LEFT(LEFT),
	.MID(MID),
	.nOVER(nOVER),
	.RESET(RESET),
	.RIGHT(RIGHT),
	.START(START),
	.TIME(TIME),
	.sampler_tx(sampler)
);

Lab6_test_vlg_check_tst tb_out(
	.G_INC_MISS(G_INC_MISS),
	.G_INC_SCORE(G_INC_SCORE),
	.G_LOAD_NOTE(G_LOAD_NOTE),
	.G_nCLRPT(G_nCLRPT),
	.G_SHIFT(G_SHIFT),
	.G_STATE(G_STATE),
	.INC_MISS(INC_MISS),
	.INC_SCORE(INC_SCORE),
	.LOAD_NOTE(LOAD_NOTE),
	.nCLRPT(nCLRPT),
	.output_error(output_error),
	.SHIFT(SHIFT),
	.STATE(STATE),
	.state_error(state_error),
	.sampler_rx(sampler)
);
endmodule

